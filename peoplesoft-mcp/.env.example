# ─────────────────────────────────────────────────────────────────────────────
# PeopleSoft MCP Server — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# The .env file is listed in .gitignore and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Base URL of your PeopleSoft web server (no trailing slash)
# Example: https://ps.example.com:8000
PEOPLESOFT_BASE_URL=https://your-peoplesoft-server:8000

# ── Authentication ────────────────────────────────────────────────────────────
#
# AUTH_METHOD: "basic" (default) or "oauth"
PEOPLESOFT_AUTH_METHOD=basic

# PeopleSoft operator ID and password used for API calls
PEOPLESOFT_USERNAME=PS
PEOPLESOFT_PASSWORD=changeme

# OAuth 2.0 — only required when AUTH_METHOD=oauth
# Register a client in PeopleTools > Security > OAuth > Configure OAuth
PEOPLESOFT_OAUTH_CLIENT_ID=
PEOPLESOFT_OAUTH_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# HTTP request timeout in seconds (default: 30)
PEOPLESOFT_TIMEOUT=30

# Set to "false" to disable TLS certificate verification (development only)
PEOPLESOFT_VERIFY_SSL=true
